generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ParkSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  submittedParks Park[]    @relation("ParkSubmitter")
  workouts       Workout[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Park {
  id      Int     @id @default(autoincrement())
  name    String
  title   String?
  lat     Float
  lon     Float
  address String?

  equipment ParkEquipment[]

  submissionStatus ParkSubmissionStatus @default(APPROVED)
  submittedById    String?
  submittedBy      User?                @relation("ParkSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  photoUrl         String?
  reviewedAt       DateTime?
  rejectionReason  String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lat, lon], map: "park_lat_lon_idx")
  @@index([submissionStatus])
  @@index([submittedById])
}

model Equipment {
  id   Int    @id @default(autoincrement())
  name String @unique

  parks ParkEquipment[]
}

model ParkEquipment {
  parkId      Int
  equipmentId Int

  park      Park      @relation(fields: [parkId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([parkId, equipmentId])
}

model Exercise {
  id           String  @id
  slug         String  @unique
  name         String
  muscle       String
  thumbnailUrl String?
  videoUrl     String?

  workoutExercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([muscle])
  @@index([name])
}

model Workout {
  id          Int       @id @default(autoincrement())
  userId      String
  title       String?
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id         Int     @id @default(autoincrement())
  workoutId  Int
  exerciseId String
  order      Int
  notes      String?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                Int     @id @default(autoincrement())
  workoutExerciseId Int
  order             Int
  reps              Int?
  weight            Float?
  durationSeconds   Int?
  distanceMeters    Float?
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutExerciseId, order])
}
