generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ParkSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkoutVisibility {
  PRIVATE
  PUBLIC
}

enum ExerciseTrackingType {
  NOT_SELECTED
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  EXTERNAL_WEIGHT
  DURATION
  DISTANCE_DURATION
  STEPS_DISTANCE_DURATION
  FLOORS_DISTANCE_DURATION
  WEIGHT_DISTANCE_DURATION
}

enum RewardTransactionType {
  WORKOUT_COMPLETED
  STREAK
  PARK_APPROVED
  PHOTO_APPROVED
  CHALLENGE
  ADMIN
  REDEMPTION
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PersonalRecordType {
  MAX_EXTERNAL_WEIGHT
  MAX_ADDED_WEIGHT
  MAX_REPS
  MAX_SET_VOLUME
  MAX_EXERCISE_VOLUME
  LONGEST_DURATION
}

enum WorkoutTemplateVisibility {
  PRIVATE
  PUBLIC
}

enum TrainingStyle {
  CALISTHENICS
  GYM
  BOTH
}

enum PrimaryGoal {
  FIND_PARKS
  TRACK_WORKOUTS
  BOTH
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bodyweightKg  Float?
  rewardPoints  Int       @default(0)
  onboardingCompleted Boolean @default(false)
  trainingStyle TrainingStyle?
  primaryGoal PrimaryGoal?
  rpeTrackingEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  submittedParks      Park[]               @relation("ParkSubmitter")
  parkEditSubmissions ParkEditSubmission[] @relation("ParkEditSubmitter")
  parkPhotos          ParkPhoto[]          @relation("ParkPhotoUploader")
  workouts            Workout[]
  following           UserFollow[]         @relation("UserFollowing")
  followers           UserFollow[]         @relation("UserFollowers")
  rewardTransactions  RewardTransaction[]
  rewardRedemptions   RewardRedemption[]
  personalRecords      PersonalRecord[]
  workoutTemplates     WorkoutTemplate[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Park {
  id      Int     @id @default(autoincrement())
  name    String
  title   String?
  lat     Float
  lon     Float
  address String?

  equipment ParkEquipment[]
  photos    ParkPhoto[]
  edits     ParkEditSubmission[]

  submissionStatus ParkSubmissionStatus @default(APPROVED)
  submittedById    String?
  submittedBy      User?                @relation("ParkSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  photoUrl         String?
  photoKey         String?
  photoLocationVerifications Json?
  nearbyParkWarning Boolean @default(false)
  closestNearbyParkId Int?
  closestNearbyParkDistanceMeters Float?
  reviewedAt       DateTime?
  rejectionReason  String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lat, lon], map: "park_lat_lon_idx")
  @@index([submissionStatus])
  @@index([submittedById])
}

model Equipment {
  id   Int    @id @default(autoincrement())
  name String @unique

  parks ParkEquipment[]
}

model ParkEquipment {
  parkId      Int
  equipmentId Int

  park      Park      @relation(fields: [parkId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([parkId, equipmentId])
}

model ParkPhoto {
  id           Int       @id @default(autoincrement())
  parkId       Int
  url          String
  uploadedById String?
  isPrimary    Boolean   @default(false)
  hiddenAt     DateTime?

  park       Park  @relation(fields: [parkId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("ParkPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([parkId])
  @@index([parkId, isPrimary])
  @@index([parkId, hiddenAt])
  @@index([uploadedById])
}

model ParkEditSubmission {
  id            Int                  @id @default(autoincrement())
  parkId        Int
  submittedById String
  status        ParkSubmissionStatus @default(PENDING)

  name         String
  title        String?
  address      String?
  lat          Float
  lon          Float
  equipmentIds Int[]    @default([])
  photoUrls    String[] @default([])
  photoKeys    String[] @default([])
  photoLocationVerifications Json?

  reviewedAt      DateTime?
  rejectionReason String?

  park        Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ParkEditSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([submittedById])
  @@index([status])
}

model Exercise {
  id                   String               @id
  slug                 String               @unique
  name                 String
  muscle               String
  thumbnailUrl         String?
  videoUrl             String?
  trackingType         ExerciseTrackingType @default(NOT_SELECTED)
  bodyweightLoadFactor Float?

  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]
  templateExercises WorkoutTemplateExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([muscle])
  @@index([name])
  @@index([trackingType])
}

model Workout {
  id          Int               @id @default(autoincrement())
  userId      String
  title       String?
  notes       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  visibility  WorkoutVisibility @default(PUBLIC)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  personalRecords PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([visibility, completedAt])
}

model WorkoutExercise {
  id         Int     @id @default(autoincrement())
  workoutId  Int
  exerciseId String
  order      Int
  notes      String?
  restSeconds Int?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                Int     @id @default(autoincrement())
  workoutExerciseId Int
  order             Int
  reps              Int?
  weight            Float?
  durationSeconds   Int?
  distanceMeters    Float?
  steps             Int?
  floors            Int?
  rpe               Float?
  notes             String?
  completed         Boolean @default(false)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutExerciseId, order])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model RewardTransaction {
  id          Int                   @id @default(autoincrement())
  userId      String
  type        RewardTransactionType
  points      Int
  description String
  referenceId String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceId])
}

model Reward {
  id          Int     @id @default(autoincrement())
  title       String
  partnerName String
  description String
  imageUrl    String?
  pointsCost  Int
  active      Boolean @default(true)

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, partnerName])
  @@index([active])
  @@index([pointsCost])
}

model RewardRedemption {
  id        Int                    @id @default(autoincrement())
  userId    String
  rewardId  Int
  status    RewardRedemptionStatus @default(PENDING)
  createdAt DateTime               @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([rewardId])
  @@index([status])
}

model PersonalRecord {
  id           Int                @id @default(autoincrement())
  userId       String
  exerciseId   String
  type         PersonalRecordType
  value        Float
  workoutId    Int
  workoutSetId Int?
  achievedAt   DateTime
  createdAt    DateTime           @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout    Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet? @relation(fields: [workoutSetId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId, type])
  @@index([userId, achievedAt])
  @@index([exerciseId])
  @@index([workoutId])
  @@index([workoutSetId])
}

model WorkoutTemplate {
  id          Int                       @id @default(autoincrement())
  userId      String
  name        String
  description String?
  visibility  WorkoutTemplateVisibility @default(PRIVATE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutTemplateExercise[]

  @@index([userId, updatedAt])
  @@index([visibility])
}

model WorkoutTemplateExercise {
  id          Int     @id @default(autoincrement())
  templateId  Int
  exerciseId  String
  order       Int
  restSeconds Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template WorkoutTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutTemplateSet[]

  @@index([templateId, order])
  @@index([exerciseId])
}

model WorkoutTemplateSet {
  id                 Int    @id @default(autoincrement())
  templateExerciseId Int
  order              Int
  reps               Int?
  weightKg           Float?
  durationSec        Int?

  templateExercise WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateExerciseId, order])
}
