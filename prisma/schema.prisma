generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ParkSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkoutVisibility {
  PRIVATE
  PUBLIC
}

enum ExerciseTrackingType {
  NOT_SELECTED
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  EXTERNAL_WEIGHT
  DURATION
  DISTANCE_DURATION
  STEPS_DISTANCE_DURATION
  FLOORS_DISTANCE_DURATION
  WEIGHT_DISTANCE_DURATION
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bodyweightKg  Float?

  accounts Account[]
  sessions Session[]

  submittedParks      Park[]               @relation("ParkSubmitter")
  parkEditSubmissions ParkEditSubmission[] @relation("ParkEditSubmitter")
  parkPhotos          ParkPhoto[]          @relation("ParkPhotoUploader")
  workouts            Workout[]
  following           UserFollow[]         @relation("UserFollowing")
  followers           UserFollow[]         @relation("UserFollowers")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Park {
  id      Int     @id @default(autoincrement())
  name    String
  title   String?
  lat     Float
  lon     Float
  address String?

  equipment ParkEquipment[]
  photos    ParkPhoto[]
  edits     ParkEditSubmission[]

  submissionStatus ParkSubmissionStatus @default(APPROVED)
  submittedById    String?
  submittedBy      User?                @relation("ParkSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  photoUrl         String?
  photoKey         String?
  reviewedAt       DateTime?
  rejectionReason  String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lat, lon], map: "park_lat_lon_idx")
  @@index([submissionStatus])
  @@index([submittedById])
}

model Equipment {
  id   Int    @id @default(autoincrement())
  name String @unique

  parks ParkEquipment[]
}

model ParkEquipment {
  parkId      Int
  equipmentId Int

  park      Park      @relation(fields: [parkId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([parkId, equipmentId])
}

model ParkPhoto {
  id           Int       @id @default(autoincrement())
  parkId       Int
  url          String
  uploadedById String?
  isPrimary    Boolean   @default(false)
  hiddenAt     DateTime?

  park       Park  @relation(fields: [parkId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("ParkPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([parkId])
  @@index([parkId, isPrimary])
  @@index([parkId, hiddenAt])
  @@index([uploadedById])
}

model ParkEditSubmission {
  id            Int                  @id @default(autoincrement())
  parkId        Int
  submittedById String
  status        ParkSubmissionStatus @default(PENDING)

  name         String
  title        String?
  address      String?
  lat          Float
  lon          Float
  equipmentIds Int[]    @default([])
  photoUrls    String[] @default([])
  photoKeys    String[] @default([])

  reviewedAt      DateTime?
  rejectionReason String?

  park        Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ParkEditSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([submittedById])
  @@index([status])
}

model Exercise {
  id                   String               @id
  slug                 String               @unique
  name                 String
  muscle               String
  thumbnailUrl         String?
  videoUrl             String?
  trackingType         ExerciseTrackingType @default(NOT_SELECTED)
  bodyweightLoadFactor Float?

  workoutExercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([muscle])
  @@index([name])
  @@index([trackingType])
}

model Workout {
  id          Int               @id @default(autoincrement())
  userId      String
  title       String?
  notes       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  visibility  WorkoutVisibility @default(PUBLIC)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([visibility, completedAt])
}

model WorkoutExercise {
  id         Int     @id @default(autoincrement())
  workoutId  Int
  exerciseId String
  order      Int
  notes      String?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                Int     @id @default(autoincrement())
  workoutExerciseId Int
  order             Int
  reps              Int?
  weight            Float?
  durationSeconds   Int?
  distanceMeters    Float?
  steps             Int?
  floors            Int?
  notes             String?
  completed         Boolean @default(false)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutExerciseId, order])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}
