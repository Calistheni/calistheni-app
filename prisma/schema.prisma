generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ParkSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParkQrStatus {
  NOT_INSTALLED
  INSTALLED
  NEEDS_REPLACEMENT
}

enum WorkoutVisibility {
  PRIVATE
  PUBLIC
}

enum WorkoutNotificationType {
  WORKOUT_LIKED
  WORKOUT_COMMENTED
}

enum FoodType {
  GENERIC
  BRANDED
  RECIPE
  USER_CREATED
}

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  USER
  CALISTHENI
}

enum FoodVerificationStatus {
  UNVERIFIED
  OFFICIAL_SOURCE
  COMMUNITY_SOURCE
  COMMUNITY_REVIEWED
  CALISTHENI_VERIFIED
  DISPUTED
}

enum FoodImportStatus {
  ACTIVE
  INCOMPLETE
  ARCHIVED
}

enum FoodFreshnessStatus {
  FRESH
  STALE
  REVALIDATING
  PROVIDER_UNAVAILABLE
  SOURCE_REMOVED
}

enum FoodRevisionReason {
  INITIAL_IMPORT
  PROVIDER_UPDATE
  ADMIN_CORRECTION
  USER_CORRECTION
  NORMALIZATION_CHANGE
  MANUAL_REFRESH
}

enum FoodDataValueSource {
  PROVIDER
  DERIVED
  MANUAL
}

enum ExerciseTrackingType {
  NOT_SELECTED
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  EXTERNAL_WEIGHT
  DURATION
  DISTANCE_DURATION
  STEPS_DISTANCE_DURATION
  FLOORS_DISTANCE_DURATION
  WEIGHT_DISTANCE_DURATION
}

enum RewardTransactionType {
  WORKOUT_COMPLETED
  STREAK
  PARK_APPROVED
  PHOTO_APPROVED
  CHALLENGE
  ADMIN
  REDEMPTION
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PersonalRecordType {
  MAX_EXTERNAL_WEIGHT
  MAX_ADDED_WEIGHT
  MAX_REPS
  MAX_SET_VOLUME
  MAX_EXERCISE_VOLUME
  LONGEST_DURATION
}

enum WorkoutTemplateVisibility {
  PRIVATE
  PUBLIC
}

enum SupersetColorKey {
  BLUE
  VIOLET
  AMBER
  GREEN
}

enum TrainingStyle {
  CALISTHENICS
  GYM
  BOTH
}

enum PrimaryGoal {
  FIND_PARKS
  TRACK_WORKOUTS
  BOTH
}

enum SubscriptionPlan {
  FREE
  PRO_MONTHLY
  PRO_YEARLY
  PRO_LIFETIME
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum NativeAuthPlatform {
  IOS
  ANDROID
}

enum SupplementFrequency {
  DAILY
  SELECTED_WEEKDAYS
  EVERY_N_DAYS
  TIMES_PER_WEEK
  AS_NEEDED
}

enum SupplementTimeOfDay {
  MORNING
  PRE_WORKOUT
  POST_WORKOUT
  AFTERNOON
  EVENING
  BEDTIME
  CUSTOM
}

/// Explicit, optional value used only to choose the appropriate US Navy formula.
/// It intentionally has no default so existing users are never assigned a formula.
enum BodyFatSex {
  MALE
  FEMALE
}

model User {
  id                      String         @id @default(cuid())
  name                    String?
  email                   String?        @unique
  emailVerified           DateTime?
  image                   String?
  username                String?        @unique
  bodyweightKg            Float?
  bodyFatSex              BodyFatSex?
  dateOfBirth             DateTime?
  rewardPoints            Int            @default(0)
  onboardingCompleted     Boolean        @default(false)
  trainingStyle           TrainingStyle?
  primaryGoal             PrimaryGoal?
  rpeTrackingEnabled      Boolean        @default(false)
  weeklyWorkoutGoal       Int            @default(3)
  weeklyCardioGoalMinutes Int?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  accounts           Account[]
  sessions           Session[]
  nativeAuthAttempts NativeAuthAttempt[]

  submittedParks                Park[]                   @relation("ParkSubmitter")
  parkEditSubmissions           ParkEditSubmission[]     @relation("ParkEditSubmitter")
  parkPhotos                    ParkPhoto[]              @relation("ParkPhotoUploader")
  workouts                      Workout[]
  workoutPhotos                 WorkoutPhoto[]
  following                     UserFollow[]             @relation("UserFollowing")
  followers                     UserFollow[]             @relation("UserFollowers")
  workoutLikes                  WorkoutLike[]
  workoutComments               WorkoutComment[]
  workoutNotifications          WorkoutNotification[]    @relation("WorkoutNotificationRecipient")
  triggeredWorkoutNotifications WorkoutNotification[]    @relation("WorkoutNotificationActor")
  rewardTransactions            RewardTransaction[]
  rewardRedemptions             RewardRedemption[]
  personalRecords               PersonalRecord[]
  workoutTemplates              WorkoutTemplate[]
  customExercises               Exercise[]               @relation("CustomExerciseOwner")
  subscription                  Subscription?
  nutritionEntrySnapshots       NutritionEntrySnapshot[]
  weeklyProgressReports         WeeklyProgressReport[]
  supplementPlans               UserSupplementPlan[]
  bodyMeasurementEntries        BodyMeasurementEntry[]

  @@index([username])
}

model WeeklyProgressReport {
  id                      String    @id @default(cuid())
  userId                  String
  weekStart               DateTime
  weekEnd                 DateTime
  summary                 String
  snapshot                Json
  viewedAt                DateTime?
  announcementDismissedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model SupplementDefinition {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans UserSupplementPlan[]
}

model UserSupplementPlan {
  id                     String               @id @default(cuid())
  userId                 String
  supplementDefinitionId String?
  customName             String?
  dosage                 Decimal?             @db.Decimal(10, 3)
  unit                   String?
  frequency              SupplementFrequency  @default(DAILY)
  weekdays               Int[]                @default([])
  everyNDays             Int?
  timesPerWeek           Int?
  preferredTime          SupplementTimeOfDay?
  preferredTimeCustom    String?
  notes                  String?
  isActive               Boolean              @default(true)
  archivedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementDefinition SupplementDefinition? @relation(fields: [supplementDefinitionId], references: [id], onDelete: SetNull)
  logs                 SupplementLog[]

  @@index([userId, isActive])
  @@index([supplementDefinitionId])
}

model SupplementLog {
  id                     String   @id @default(cuid())
  userSupplementPlanId   String
  scheduledFor           DateTime
  completedAt            DateTime @default(now())
  dosageSnapshot         Decimal? @db.Decimal(10, 3)
  unitSnapshot           String?
  supplementNameSnapshot String
  note                   String?
  createdAt              DateTime @default(now())

  plan UserSupplementPlan @relation(fields: [userSupplementPlanId], references: [id], onDelete: Cascade)

  @@unique([userSupplementPlanId, scheduledFor])
  @@index([scheduledFor])
}

model BodyMeasurementEntry {
  id                     String   @id @default(cuid())
  userId                 String
  measuredAt             DateTime
  note                   String?
  bodyweightKg           Decimal? @db.Decimal(7, 3)
  bodyFatPercentage      Decimal? @db.Decimal(5, 2)
  neckCm                 Decimal? @db.Decimal(7, 3)
  shouldersCm            Decimal? @db.Decimal(7, 3)
  chestCm                Decimal? @db.Decimal(7, 3)
  waistCm                Decimal? @db.Decimal(7, 3)
  abdomenCm              Decimal? @db.Decimal(7, 3)
  hipsCm                 Decimal? @db.Decimal(7, 3)
  leftUpperArmCm         Decimal? @db.Decimal(7, 3)
  rightUpperArmCm        Decimal? @db.Decimal(7, 3)
  leftForearmCm          Decimal? @db.Decimal(7, 3)
  rightForearmCm         Decimal? @db.Decimal(7, 3)
  leftThighCm            Decimal? @db.Decimal(7, 3)
  rightThighCm           Decimal? @db.Decimal(7, 3)
  leftCalfCm             Decimal? @db.Decimal(7, 3)
  rightCalfCm            Decimal? @db.Decimal(7, 3)
  heightCm               Decimal? @db.Decimal(7, 3)
  wristCm                Decimal? @db.Decimal(7, 3)
  ankleCm                Decimal? @db.Decimal(7, 3)
  upperChestCm           Decimal? @db.Decimal(7, 3)
  waistNarrowestCm       Decimal? @db.Decimal(7, 3)
  glutesCm               Decimal? @db.Decimal(7, 3)
  pelvisCm               Decimal? @db.Decimal(7, 3)
  leftUpperArmRelaxedCm  Decimal? @db.Decimal(7, 3)
  rightUpperArmRelaxedCm Decimal? @db.Decimal(7, 3)
  leftWristCm            Decimal? @db.Decimal(7, 3)
  rightWristCm           Decimal? @db.Decimal(7, 3)
  leftAnkleCm            Decimal? @db.Decimal(7, 3)
  rightAnkleCm           Decimal? @db.Decimal(7, 3)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

model Subscription {
  id                              String             @id @default(cuid())
  userId                          String             @unique
  stripeCustomerId                String?            @unique
  stripeSubscriptionId            String?            @unique
  stripePriceId                   String?
  plan                            SubscriptionPlan   @default(FREE)
  status                          SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd                DateTime?
  cancelAtPeriodEnd               Boolean            @default(false)
  lifetimePurchasedAt             DateTime?
  stripeLifetimeCheckoutSessionId String?            @unique
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PartnerInquiry {
  id             Int      @id @default(autoincrement())
  businessName   String
  contactName    String
  email          String
  website        String
  category       String
  cityCountry    String
  proposedReward String
  message        String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A short-lived bridge between the external OAuth browser session and the
/// first-party Capacitor WebView. Raw nonces and handoff codes are never kept.
model NativeAuthAttempt {
  id              String             @id @default(cuid())
  platform        NativeAuthPlatform
  nonceHash       String
  handoffCodeHash String?            @unique
  redirectPath    String             @default("/home")
  expiresAt       DateTime
  handoffIssuedAt DateTime?
  consumedAt      DateTime?
  createdAt       DateTime           @default(now())
  userId          String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@index([consumedAt])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Park {
  id      Int     @id @default(autoincrement())
  name    String
  title   String?
  lat     Float
  lon     Float
  address String?

  equipment ParkEquipment[]
  photos    ParkPhoto[]
  edits     ParkEditSubmission[]

  submissionStatus                ParkSubmissionStatus @default(APPROVED)
  submittedById                   String?
  submittedBy                     User?                @relation("ParkSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  photoUrl                        String?
  photoKey                        String?
  photoLocationVerifications      Json?
  nearbyParkWarning               Boolean              @default(false)
  closestNearbyParkId             Int?
  closestNearbyParkDistanceMeters Float?
  reviewedAt                      DateTime?
  rejectionReason                 String?
  qrStatus                        ParkQrStatus         @default(NOT_INSTALLED)
  qrInstalledAt                   DateTime?
  qrInstalledByLabel              String?
  qrStatusUpdatedAt               DateTime?
  qrCodeNote                      String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lat, lon], map: "park_lat_lon_idx")
  @@index([submissionStatus])
  @@index([submittedById])
  @@index([qrStatus])
}

model Equipment {
  id   Int    @id @default(autoincrement())
  name String @unique

  parks ParkEquipment[]
}

model ParkEquipment {
  parkId      Int
  equipmentId Int

  park      Park      @relation(fields: [parkId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([parkId, equipmentId])
}

model ParkPhoto {
  id           Int       @id @default(autoincrement())
  parkId       Int
  url          String
  uploadedById String?
  isPrimary    Boolean   @default(false)
  hiddenAt     DateTime?

  park       Park  @relation(fields: [parkId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("ParkPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([parkId])
  @@index([parkId, isPrimary])
  @@index([parkId, hiddenAt])
  @@index([uploadedById])
}

model ParkEditSubmission {
  id            Int                  @id @default(autoincrement())
  parkId        Int
  submittedById String
  status        ParkSubmissionStatus @default(PENDING)

  name                       String
  title                      String?
  address                    String?
  lat                        Float
  lon                        Float
  equipmentIds               Int[]    @default([])
  photoUrls                  String[] @default([])
  photoKeys                  String[] @default([])
  photoLocationVerifications Json?

  reviewedAt      DateTime?
  rejectionReason String?

  park        Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ParkEditSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([submittedById])
  @@index([status])
}

model Exercise {
  id                   String               @id
  slug                 String               @unique
  name                 String
  muscle               String
  secondaryMuscles     String[]             @default([])
  thumbnailUrl         String?
  videoUrl             String?
  trackingType         ExerciseTrackingType @default(NOT_SELECTED)
  bodyweightLoadFactor Float?
  createdByUserId      String?
  createdByUser        User?                @relation("CustomExerciseOwner", fields: [createdByUserId], references: [id], onDelete: Restrict)

  workoutExercises  WorkoutExercise[]
  personalRecords   PersonalRecord[]
  templateExercises WorkoutTemplateExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([muscle])
  @@index([name])
  @@index([trackingType])
  @@index([createdByUserId])
}

model Workout {
  id          Int               @id @default(autoincrement())
  userId      String
  title       String?
  notes       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  visibility  WorkoutVisibility @default(PUBLIC)

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  supersets       WorkoutSuperset[]
  personalRecords PersonalRecord[]
  likes           WorkoutLike[]
  comments        WorkoutComment[]
  notifications   WorkoutNotification[]
  photos          WorkoutPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([visibility, completedAt])
}

model WorkoutPhoto {
  id                 String   @id @default(cuid())
  workoutId          Int
  userId             String
  storageKey         String   @unique
  width              Int
  height             Int
  fileSizeBytes      Int
  mimeType           String
  originalFileName   String
  uploadedFrom       String   @default("web")
  compressionVersion Int      @default(1)
  createdAt          DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workoutId, createdAt])
  @@index([userId, createdAt])
}

model WorkoutLike {
  workoutId Int
  userId    String
  createdAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workoutId, userId])
  @@index([userId, createdAt])
}

model WorkoutComment {
  id        String   @id @default(cuid())
  workoutId Int
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workout       Workout               @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications WorkoutNotification[]

  @@index([workoutId, createdAt])
  @@index([userId, createdAt])
}

model WorkoutNotification {
  id        String                  @id @default(cuid())
  userId    String
  actorId   String
  workoutId Int
  commentId String?
  type      WorkoutNotificationType
  readAt    DateTime?
  createdAt DateTime                @default(now())

  user    User            @relation("WorkoutNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User            @relation("WorkoutNotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  workout Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  comment WorkoutComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workoutId, createdAt])
}

model Food {
  id                  String                 @id @default(cuid())
  type                FoodType
  name                String
  normalizedName      String
  description         String?
  brandName           String?
  barcode             String?                @unique
  imageUrl            String?
  /// Optional curator-selected generic icon key. Automatically resolved icons
  /// remain computed from the local public icon inventory.
  iconKey             String?
  languageCode        String?
  countryCodes        String[]               @default([])
  nutritionBasisGrams Decimal                @default(100) @db.Decimal(10, 3)
  caloriesKcal        Decimal?               @db.Decimal(12, 3)
  proteinGrams        Decimal?               @db.Decimal(12, 3)
  carbohydrateGrams   Decimal?               @db.Decimal(12, 3)
  fatGrams            Decimal?               @db.Decimal(12, 3)
  fiberGrams          Decimal?               @db.Decimal(12, 3)
  sugarGrams          Decimal?               @db.Decimal(12, 3)
  saturatedFatGrams   Decimal?               @db.Decimal(12, 3)
  transFatGrams       Decimal?               @db.Decimal(12, 3)
  addedSugarGrams     Decimal?               @db.Decimal(12, 3)
  sodiumMg            Decimal?               @db.Decimal(12, 3)
  saltGrams           Decimal?               @db.Decimal(12, 3)
  cholesterolMg       Decimal?               @db.Decimal(12, 3)
  potassiumMg         Decimal?               @db.Decimal(12, 3)
  calciumMg           Decimal?               @db.Decimal(12, 3)
  ironMg              Decimal?               @db.Decimal(12, 3)
  calorieValueSource  FoodDataValueSource    @default(PROVIDER)
  source              FoodSource
  sourceExternalId    String
  sourceUpdatedAt     DateTime?
  importedAt          DateTime               @default(now())
  lastFetchedAt       DateTime?
  lastRevalidatedAt   DateTime?
  nextRevalidateAt    DateTime?
  verificationStatus  FoodVerificationStatus
  importStatus        FoodImportStatus       @default(ACTIVE)
  freshnessStatus     FoodFreshnessStatus    @default(FRESH)
  confidenceScore     Decimal                @default(0) @db.Decimal(5, 4)
  currentRevisionId   String?                @unique
  searchCount         Int                    @default(0)
  selectionCount      Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  servings           FoodServing[]
  details            FoodDetails?
  nutrients          FoodNutrient[]
  aliases            FoodAlias[]
  sourceRecords      FoodSourceRecord[]
  revisions          FoodRevision[]           @relation("FoodRevisions")
  currentRevision    FoodRevision?            @relation("FoodCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  nutritionSnapshots NutritionEntrySnapshot[]

  @@unique([source, sourceExternalId])
  @@index([normalizedName])
  @@index([brandName])
  @@index([source])
  @@index([sourceExternalId])
  @@index([freshnessStatus])
  @@index([nextRevalidateAt])
  @@index([searchCount])
  @@index([selectionCount])
}

model FoodDetails {
  id                   String    @id @default(cuid())
  foodId               String    @unique
  productImageUrl      String?
  nutritionImageUrl    String?
  ingredientsImageUrl  String?
  packageQuantityText  String?
  packageQuantityGrams Decimal?  @db.Decimal(12, 3)
  servingSizeText      String?
  defaultServingGrams  Decimal?  @db.Decimal(12, 3)
  categories           String[]  @default([])
  labels               String[]  @default([])
  ingredientsText      String?
  allergens            String[]  @default([])
  traces               String[]  @default([])
  additives            String[]  @default([])
  nutriScoreGrade      String?
  novaGroup            Int?
  nutrientLevels       Json?
  veganStatus          String?
  vegetarianStatus     String?
  palmOilStatus        String?
  providerCreatedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model FoodNutrient {
  id               String     @id @default(cuid())
  foodId           String
  nutrientKey      String
  displayName      String
  amount           Decimal    @db.Decimal(12, 3)
  unit             String
  basisGrams       Decimal    @default(100) @db.Decimal(10, 3)
  source           FoodSource
  sourceExternalId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, nutrientKey, unit])
  @@index([foodId])
}

model FoodServing {
  id               String     @id @default(cuid())
  foodId           String
  name             String
  quantity         Decimal    @default(1) @db.Decimal(12, 3)
  grams            Decimal    @db.Decimal(12, 3)
  householdUnit    String?
  isDefault        Boolean    @default(false)
  source           FoodSource
  sourceExternalId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

model FoodAlias {
  id             String     @id @default(cuid())
  foodId         String
  name           String
  normalizedName String
  languageCode   String?
  source         FoodSource
  createdAt      DateTime   @default(now())

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, normalizedName])
  @@index([normalizedName])
}

model FoodSourceRecord {
  id               String     @id @default(cuid())
  foodId           String
  source           FoodSource
  sourceExternalId String
  rawData          Json
  fetchedAt        DateTime   @default(now())
  sourceUpdatedAt  DateTime?
  checksum         String
  sourceVersion    String?
  httpEtag         String?
  httpLastModified String?
  responseStatus   Int
  createdAt        DateTime   @default(now())

  food      Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)
  revisions FoodRevision[]

  @@index([foodId, fetchedAt])
  @@index([source, sourceExternalId])
  @@index([checksum])
}

model FoodRevision {
  id                     String                 @id @default(cuid())
  foodId                 String
  revisionNumber         Int
  reason                 FoodRevisionReason
  source                 FoodSource
  sourceExternalId       String
  name                   String
  brandName              String?
  barcode                String?
  imageUrl               String?
  nutritionBasisGrams    Decimal                @default(100) @db.Decimal(10, 3)
  caloriesKcal           Decimal?               @db.Decimal(12, 3)
  proteinGrams           Decimal?               @db.Decimal(12, 3)
  carbohydrateGrams      Decimal?               @db.Decimal(12, 3)
  fatGrams               Decimal?               @db.Decimal(12, 3)
  fiberGrams             Decimal?               @db.Decimal(12, 3)
  sugarGrams             Decimal?               @db.Decimal(12, 3)
  saturatedFatGrams      Decimal?               @db.Decimal(12, 3)
  transFatGrams          Decimal?               @db.Decimal(12, 3)
  addedSugarGrams        Decimal?               @db.Decimal(12, 3)
  sodiumMg               Decimal?               @db.Decimal(12, 3)
  saltGrams              Decimal?               @db.Decimal(12, 3)
  cholesterolMg          Decimal?               @db.Decimal(12, 3)
  potassiumMg            Decimal?               @db.Decimal(12, 3)
  calciumMg              Decimal?               @db.Decimal(12, 3)
  ironMg                 Decimal?               @db.Decimal(12, 3)
  confidenceScore        Decimal                @default(0) @db.Decimal(5, 4)
  verificationStatus     FoodVerificationStatus
  sourceUpdatedAt        DateTime?
  sourceRecordId         String?
  normalizedDataChecksum String
  createdByUserId        String?
  createdAt              DateTime               @default(now())

  food               Food                     @relation("FoodRevisions", fields: [foodId], references: [id], onDelete: Cascade)
  currentFor         Food?                    @relation("FoodCurrentRevision")
  sourceRecord       FoodSourceRecord?        @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  nutritionSnapshots NutritionEntrySnapshot[]

  @@unique([foodId, revisionNumber])
  @@index([foodId, createdAt])
  @@index([normalizedDataChecksum])
}

// Future meal logging persists a calculated immutable snapshot instead of
// recalculating old entries from the mutable Food row.
model NutritionEntrySnapshot {
  id                          String     @id @default(cuid())
  userId                      String
  foodId                      String
  foodRevisionId              String
  foodNameSnapshot            String
  brandNameSnapshot           String?
  barcodeSnapshot             String?
  quantity                    Decimal    @db.Decimal(12, 3)
  unit                        String
  gramsConsumed               Decimal    @db.Decimal(12, 3)
  caloriesKcalSnapshot        Decimal?   @db.Decimal(12, 3)
  proteinGramsSnapshot        Decimal?   @db.Decimal(12, 3)
  carbohydrateGramsSnapshot   Decimal?   @db.Decimal(12, 3)
  fatGramsSnapshot            Decimal?   @db.Decimal(12, 3)
  fiberGramsSnapshot          Decimal?   @db.Decimal(12, 3)
  sugarGramsSnapshot          Decimal?   @db.Decimal(12, 3)
  saturatedFatGramsSnapshot   Decimal?   @db.Decimal(12, 3)
  sodiumMgSnapshot            Decimal?   @db.Decimal(12, 3)
  saltGramsSnapshot           Decimal?   @db.Decimal(12, 3)
  nutritionBasisGramsSnapshot Decimal    @db.Decimal(10, 3)
  sourceSnapshot              FoodSource
  sourceExternalIdSnapshot    String
  createdAt                   DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  food         Food         @relation(fields: [foodId], references: [id], onDelete: Restrict)
  foodRevision FoodRevision @relation(fields: [foodRevisionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([foodId])
  @@index([foodRevisionId])
}

model WorkoutSuperset {
  id             String           @id
  workoutId      Int
  order          Int
  label          String?
  colorKey       SupersetColorKey
  restSeconds    Int?
  plannedRounds  Int?
  hardRoundLimit Int?

  workout             Workout                   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises           WorkoutExercise[]
  exerciseMemberships WorkoutSupersetExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutId, order])
  @@index([workoutId])
}

model WorkoutExercise {
  id               Int     @id @default(autoincrement())
  workoutId        Int
  exerciseId       String
  order            Int
  notes            String?
  restSeconds      Int?
  supersetId       String?
  supersetPosition Int?

  workout             Workout                   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise            Exercise                  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  superset            WorkoutSuperset?          @relation(fields: [supersetId], references: [id], onDelete: SetNull)
  supersetMemberships WorkoutSupersetExercise[]
  sets                WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId, order])
  @@index([exerciseId])
  @@index([supersetId, supersetPosition])
}

// Normalized membership lets one workout exercise participate in more than
// one superset without duplicating the exercise or its recorded sets.
model WorkoutSupersetExercise {
  supersetId        String
  workoutExerciseId Int
  position          Int

  superset        WorkoutSuperset @relation(fields: [supersetId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@id([supersetId, workoutExerciseId])
  @@unique([supersetId, position])
  @@index([workoutExerciseId])
}

model WorkoutSet {
  id                 Int     @id @default(autoincrement())
  workoutExerciseId  Int
  order              Int
  reps               Int?
  weight             Float?
  durationSeconds    Int?
  distanceMeters     Float?
  steps              Int?
  floors             Int?
  rpe                Float?
  notes              String?
  completed          Boolean @default(false)
  supersetRoundIndex Int?
  supersetRoundId    String?

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutExerciseId, order])
  @@index([workoutExerciseId, supersetRoundIndex])
  @@index([supersetRoundId])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model RewardTransaction {
  id          Int                   @id @default(autoincrement())
  userId      String
  type        RewardTransactionType
  points      Int
  description String
  referenceId String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceId])
}

model Reward {
  id          Int     @id @default(autoincrement())
  title       String
  partnerName String
  description String
  imageUrl    String?
  pointsCost  Int
  active      Boolean @default(true)

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, partnerName])
  @@index([active])
  @@index([pointsCost])
}

model RewardRedemption {
  id        Int                    @id @default(autoincrement())
  userId    String
  rewardId  Int
  status    RewardRedemptionStatus @default(PENDING)
  createdAt DateTime               @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([rewardId])
  @@index([status])
}

model PersonalRecord {
  id           Int                @id @default(autoincrement())
  userId       String
  exerciseId   String
  type         PersonalRecordType
  value        Float
  workoutId    Int
  workoutSetId Int?
  achievedAt   DateTime
  createdAt    DateTime           @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout    Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet? @relation(fields: [workoutSetId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId, type])
  @@index([userId, achievedAt])
  @@index([exerciseId])
  @@index([workoutId])
  @@index([workoutSetId])
}

model WorkoutTemplate {
  id          Int                       @id @default(autoincrement())
  userId      String
  name        String
  description String?
  visibility  WorkoutTemplateVisibility @default(PRIVATE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutTemplateExercise[]
  supersets WorkoutTemplateSuperset[]

  @@index([userId, updatedAt])
  @@index([visibility])
}

model WorkoutTemplateSuperset {
  id             String           @id
  templateId     Int
  order          Int
  label          String?
  colorKey       SupersetColorKey
  restSeconds    Int?
  plannedRounds  Int?
  hardRoundLimit Int?

  template            WorkoutTemplate                   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises           WorkoutTemplateExercise[]
  exerciseMemberships WorkoutTemplateSupersetExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, order])
  @@index([templateId])
}

model WorkoutTemplateExercise {
  id               Int      @id @default(autoincrement())
  templateId       Int
  exerciseId       String
  order            Int
  restSeconds      Int?
  notes            String?
  supersetId       String?
  supersetPosition Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  template            WorkoutTemplate                   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise            Exercise                          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  superset            WorkoutTemplateSuperset?          @relation(fields: [supersetId], references: [id], onDelete: SetNull)
  supersetMemberships WorkoutTemplateSupersetExercise[]
  sets                WorkoutTemplateSet[]

  @@index([templateId, order])
  @@index([exerciseId])
  @@index([supersetId, supersetPosition])
}

model WorkoutTemplateSupersetExercise {
  supersetId         String
  templateExerciseId Int
  position           Int

  superset         WorkoutTemplateSuperset @relation(fields: [supersetId], references: [id], onDelete: Cascade)
  templateExercise WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@id([supersetId, templateExerciseId])
  @@unique([supersetId, position])
  @@index([templateExerciseId])
}

model WorkoutTemplateSet {
  id                 Int    @id @default(autoincrement())
  templateExerciseId Int
  order              Int
  reps               Int?
  weightKg           Float?
  durationSec        Int?
  distanceMeters     Float?
  steps              Int?
  floors             Int?

  templateExercise WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateExerciseId, order])
}
