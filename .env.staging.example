# Documentation template only. Do not source or deploy this file as-is.
# Every external hostname is intentionally non-routable or a replacement marker.

# Deployment identity and URLs
CALISTHENI_DEPLOYMENT_TARGET=staging
NEXT_PUBLIC_SITE_URL=https://staging-calistheni.example.invalid
AUTH_URL=https://staging-calistheni.example.invalid
NEXTAUTH_URL=https://staging-calistheni.example.invalid
NEXT_PUBLIC_CALISTHENI_API_ORIGIN=https://staging-calistheni.example.invalid
NEXT_PUBLIC_ASSETS_URL=https://staging-assets.example.invalid

# Isolated PostgreSQL. Replace every component with staging-only credentials.
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@staging-postgres.example.invalid:5432/calistheni_staging?sslmode=require

# Auth.js and provider credentials
AUTH_SECRET=<generate-a-new-staging-only-auth-secret>
AUTH_GOOGLE_ID=<staging-google-oauth-client-id>
AUTH_GOOGLE_SECRET=<staging-google-oauth-client-secret>
AUTH_APPLE_ID=<staging-apple-services-id>
AUTH_APPLE_SECRET=<staging-apple-client-secret-jwt>
APPLE_TEAM_ID=<apple-developer-team-id>
APPLE_AUTH_KEY_ID=<staging-sign-in-with-apple-key-id>
APPLE_AUTH_PRIVATE_KEY=<staging-sign-in-with-apple-private-key-with-escaped-newlines>
IOS_BUNDLE_ID=<approved-staging-ios-client-id>

# Encryption and durable authentication rate limiting
AUTH_TOKEN_ENCRYPTION_KEY=<staging-legacy-32-byte-base64url-key>
AUTH_TOKEN_ENCRYPTION_KEYS={"staging-v1":"<staging-32-byte-base64url-key>"}
AUTH_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=staging-v1
AUTH_RATE_LIMIT_SECRET=<generate-a-distinct-staging-rate-limit-secret>

# Controlled staging authentication email only. The selected provider is
# exclusive; missing Brevo configuration never falls back to Resend.
AUTH_EMAIL_PROVIDER=brevo
BREVO_SMTP_HOST=<staging-brevo-smtp-host>
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=<staging-brevo-smtp-login>
BREVO_SMTP_PASSWORD=<staging-brevo-smtp-key>
AUTH_EMAIL_FROM=Calistheni Staging <accounts@staging.example.invalid>

# Resend remains the default when AUTH_EMAIL_PROVIDER is unset. Configure this
# instead of the Brevo variables when AUTH_EMAIL_PROVIDER=resend.
# RESEND_API_KEY=<staging-resend-api-key>

# Partner inquiry email remains Resend-only and is independent of
# AUTH_EMAIL_PROVIDER.
PARTNER_INQUIRY_FROM_EMAIL=Calistheni Staging <contact@staging.example.invalid>
PARTNER_INQUIRY_TO_EMAIL=<controlled-staging-mailbox>

# Stripe test mode only. Prefer a least-privilege restricted test key.
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=<staging-stripe-test-account-id>
STRIPE_SECRET_KEY=<staging-stripe-restricted-test-key>
STRIPE_WEBHOOK_SECRET=<staging-stripe-test-webhook-signing-secret>
STRIPE_PRO_MONTHLY_PRICE_ID=<staging-test-monthly-price-id>
STRIPE_PRO_YEARLY_PRICE_ID=<staging-test-yearly-price-id>
STRIPE_PRO_LIFETIME_PRICE_ID=<staging-test-lifetime-price-id>

# Apple StoreKit Sandbox/TestFlight. Values must match the approved app catalog.
APPLE_BUNDLE_ID=<approved-calistheni-bundle-id>
APPLE_APP_ID=<numeric-app-store-apple-id>
APPLE_IAP_KEY_ID=<staging-app-store-connect-iap-key-id>
APPLE_IAP_ISSUER_ID=<staging-app-store-connect-issuer-id>
APPLE_IAP_PRIVATE_KEY=<staging-app-store-connect-private-key-with-escaped-newlines>
APPLE_PRO_MONTHLY_PRODUCT_ID=<approved-monthly-product-id>
APPLE_PRO_YEARLY_PRODUCT_ID=<approved-yearly-product-id>
APPLE_PRO_LIFETIME_PRODUCT_ID=<approved-lifetime-product-id>
APPLE_SANDBOX_ENTITLEMENT_USER_IDS=

# Staging-only R2 buckets and credentials
R2_ENDPOINT=https://staging-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<staging-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<staging-r2-secret-access-key>
R2_BUCKET_NAME=<staging-exercise-media-bucket>
R2_PUBLIC_URL=https://staging-media.example.invalid
EXERCISE_R2_BUCKET_NAME=<staging-exercise-media-bucket>
PARK_PHOTO_R2_ENDPOINT=https://staging-account-id.r2.cloudflarestorage.com
PARK_PHOTO_R2_ACCESS_KEY_ID=<staging-park-photo-r2-access-key-id>
PARK_PHOTO_R2_SECRET_ACCESS_KEY=<staging-park-photo-r2-secret-access-key>
PARK_PHOTO_R2_BUCKET_NAME=<staging-park-photo-bucket>
PARK_PHOTO_R2_PUBLIC_URL=https://staging-park-media.example.invalid

# Public, staging-scoped Mapbox token
NEXT_PUBLIC_MAPBOX_TOKEN=<staging-restricted-mapbox-public-token>

# Worker authentication. The deletion placeholders intentionally match each
# other; the authentication-email secret must be different.
AUTH_EMAIL_WORKER_SECRET=<distinct-staging-auth-email-worker-secret-min-32-characters>
ACCOUNT_DELETION_WORKER_SECRET=<staging-account-deletion-worker-secret-min-32-characters>
CRON_SECRET=<same-staging-account-deletion-worker-secret-min-32-characters>
AUTH_EMAIL_BATCH_LIMIT=5
ACCOUNT_DELETION_BATCH_LIMIT=5

# Safe initial feature state. Do not enable during initial deployment.
AUTH_EMAIL_WORKER_ENABLED=false
ACCOUNT_DELETION_REQUESTS_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false

# Staging admin monitoring account
ADMIN_DISPLAY_NAME=<staging-admin-display-name>
ADMIN_PASSWORD=<staging-only-strong-admin-password>
