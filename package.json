{
  "name": "calistheni-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/*.test.mjs && tsx --test tests/*.test.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "mobile:assets": "capacitor-assets generate --ios --android --assetPath resources --iconBackgroundColor '#2563eb' --iconBackgroundColorDark '#09090b' --splashBackgroundColor '#09090b' --splashBackgroundColorDark '#09090b' --logoSplashScale 0.24",
    "mobile:sync": "cap sync",
    "mobile:prepare": "npm run build && npm run mobile:sync",
    "mobile:ios": "npm run mobile:prepare && cap open ios",
    "mobile:android": "npm run mobile:prepare && cap open android",
    "mobile:ios:build": "npm run mobile:prepare && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "mobile:android:build": "npm run mobile:prepare && cd android && ./gradlew assembleDebug",
    "seed:exercises": "node scripts/seed-exercises.mjs",
    "add:l-sit-and-ring-muscle-up": "node --env-file=.env.local scripts/add-l-sit-and-ring-muscle-up.mjs",
    "repair:l-sit-exercises": "node --env-file=.env.local scripts/repair-l-sit-exercises.mjs",
    "secondary-muscles:preview": "node --env-file=.env.local scripts/backfill-secondary-muscles.mjs",
    "secondary-muscles:apply": "node --env-file=.env.local scripts/backfill-secondary-muscles.mjs --apply",
    "seed:rewards": "node scripts/seed-rewards.mjs",
    "preview:secondary-muscles": "node --env-file=.env.local scripts/classify-secondary-muscles.mjs --dry-run",
    "classify:secondary-muscles": "node --env-file=.env.local scripts/classify-secondary-muscles.mjs",
    "cleanup:pending-park-photos": "node scripts/cleanup-pending-park-photos.mjs",
    "stripe:setup:test": "node --env-file=.env.local scripts/setup-stripe-pro.mjs",
    "stripe:setup:live": "node scripts/setup-stripe-pro-live.mjs --confirm-create-live-calistheni-prices"
  },
  "dependencies": {
    "@auth/prisma-adapter": "~2.11.2",
    "@aws-sdk/client-s3": "~3.1078.0",
    "@capacitor/android": "~8.4.2",
    "@capacitor/app": "~8.1.1",
    "@capacitor/browser": "~8.0.4",
    "@capacitor/cli": "~8.4.2",
    "@capacitor/core": "~8.4.2",
    "@capacitor/ios": "~8.4.2",
    "@capacitor/keyboard": "~8.0.5",
    "@capacitor/splash-screen": "~8.0.2",
    "@capacitor/status-bar": "~8.0.3",
    "@dnd-kit/core": "~6.3.1",
    "@dnd-kit/sortable": "~10.0.0",
    "@dnd-kit/utilities": "~3.2.2",
    "@mapbox/search-js-react": "~1.5.1",
    "@prisma/adapter-pg": "~7.8.0",
    "@prisma/client": "~7.8.0",
    "browser-image-compression": "~2.0.2",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "date-fns": "~4.4.0",
    "exifr": "~7.1.3",
    "idb": "~8.0.3",
    "lucide-react": "~1.17.0",
    "mapbox-gl": "~3.24.0",
    "next": "16.2.6",
    "next-auth": "~5.0.0-beta.31",
    "next-themes": "~0.4.6",
    "pg": "~8.21.0",
    "prisma": "~7.8.0",
    "radix-ui": "~1.5.0",
    "react": "19.2.4",
    "react-day-picker": "~10.0.1",
    "react-dom": "19.2.4",
    "recharts": "~3.9.2",
    "shadcn": "~4.11.0",
    "sonner": "~2.0.7",
    "stripe": "~22.3.1",
    "tailwind-merge": "~3.6.0",
    "tw-animate-css": "~1.4.0",
    "vaul": "~1.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "~3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "~3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "~4.23.1",
    "typescript": "^5"
  }
}
